{
    "hardware": {
        "esp32": {
            "port": "COM3",
            "baud_rate": 115200,
            "pins": {
                "microphone": 34,
                "speaker": 25,
                "pir_sensor": 26,
                "led_ring": 27,
                "temp_sensor": 32
            }
        }
    },
    "ai": {
        "speech_recognition": {
            "language": "en-US",
            "energy_threshold": 4000,
            "pause_threshold": 0.8
        },
        "sentiment_analysis": {
            "model_path": "data/models/sentiment_model.h5",
            "threshold": 0.7
        },
        "health_monitoring": {
            "hydration_reminder_interval": 3600,
            "sleep_reminder_time": "22:00",
            "activity_threshold": 1000
        }
    },
    "security": {
        "sound_threshold": 70,
        "motion_sensitivity": 0.8,
        "alert_cooldown": 300
    },
    "voice": {
        "wake_word": "hey buddy",
        "voice_id": "en-US-Neural2-F",
        "speaking_rate": 1.0
    },
    "logging": {
        "level": "INFO",
        "file": "logs/companion_cube.log",
        "max_size": 10485760,
        "backup_count": 5
    },
    "storage": {
        "voice_diary_path": "data/diary/",
        "models_path": "data/models/",
        "cache_path": "data/cache/"
    }
} 